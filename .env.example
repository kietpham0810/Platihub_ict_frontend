# Sao chép file này thành .env (local) hoặc .env.production và điền giá trị thật.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_TIMEOUT_MS=5000

# Tài khoản đăng nhập admin được cấu hình ở BACKEND (ADMIN_USERNAME/
# ADMIN_PASSWORD/ADMIN_TOKEN_SECRET trong platihub-api-ict/config), không
# còn ở frontend vì mọi biến VITE_* bị lộ trong bundle JS gửi cho trình duyệt.

VITE_IMGUR_CLIENT_ID=your_imgur_client_id
